# ---------------------------------------------------------------
# HelpTrust environment. Copy to .env.local (dev) or set in Vercel.
# NEVER commit real values. Secrets must never use NEXT_PUBLIC_.
# ---------------------------------------------------------------

# --- Database (PostgreSQL). Use a pooled URL for the app and a direct URL for migrations.
DATABASE_URL="postgresql://postgres:postgres@localhost:5432/helptrust?schema=public"
DIRECT_URL="postgresql://postgres:postgres@localhost:5432/helptrust?schema=public"

# --- App
NEXT_PUBLIC_APP_URL="http://localhost:3000"
APP_ENV="development"            # development | staging | production

# --- Secrets (generate each with: openssl rand -base64 32)
# 32-byte base64 key for AES-256-GCM encryption of PII, bank numbers and documents at rest.
ENCRYPTION_KEY=""
# Secret for HMAC hashing of mobile numbers and emails (lookup without storing plaintext).
PII_HASH_PEPPER=""
# Signs session JWTs.
SESSION_SECRET=""
# Signs time-limited download URLs for private documents.
FILE_SIGNING_SECRET=""

# --- Private document storage (never inside /public).
# Local disk for development. Use a private S3-compatible bucket in production.
STORAGE_DIR="./storage/private"
MAX_UPLOAD_MB="10"

# --- Authentication and OTP
OTP_TTL_SECONDS="300"
OTP_MAX_ATTEMPTS="5"
# Provider for OTP SMS: "console" (dev only) or a DLT-registered provider adapter.
SMS_PROVIDER="console"
# Email provider: "console" (dev only) or an approved transactional email provider.
EMAIL_PROVIDER="console"
# WhatsApp Business provider (optional): "none" or an approved BSP adapter.
WHATSAPP_PROVIDER="none"

# --- Identity / bank verification (authorised KYC provider)
# "mock" is only permitted in development and test. Production refuses to start with mock.
KYC_PROVIDER="mock"

# --- Payments (Razorpay). Sandbox until production credentials and legal approvals exist.
# "mock" = local sandbox that simulates Razorpay orders and signed webhooks.
PAYMENT_PROVIDER="mock"
RAZORPAY_KEY_ID=""               # public key id (test: rzp_test_...)
RAZORPAY_KEY_SECRET=""           # server only
RAZORPAY_WEBHOOK_SECRET=""       # server only, configured in the Razorpay dashboard
MOCK_PAYMENT_SECRET="dev-only-mock-payment-secret"

# --- Limits (paise). Defaults: min Rs 50, max Rs 5,00,000 per donation.
DONATION_MIN_PAISE="5000"
DONATION_MAX_PAISE="50000000"
# Campaign request cap, kept below the 32-bit integer limit used for money columns.
CAMPAIGN_MAX_REQUEST_PAISE="990000000"

# --- Fraud monitoring thresholds
FRAUD_DONATIONS_PER_HOUR_PER_IP="25"

# --- Seed data (development only)
SEED_ADMIN_PASSWORD_HINT="Admin logins use OTP. Seeded admin mobile numbers are listed in prisma/seed.ts."
