# ---- Database (PostgreSQL 14+) ----
DATABASE_URL="postgresql://binarypro:change-me@localhost:5432/binarypro?schema=public"
DIRECT_URL="postgresql://binarypro:change-me@localhost:5432/binarypro?schema=public"

# ---- Secrets (required in production; generate with: openssl rand -base64 48) ----
SESSION_SECRET=""
OTP_PEPPER=""
PAYMENT_WEBHOOK_SECRET=""

# ---- Providers ----
# mock | razorpay  (mock is refused in production)
PAYMENT_PROVIDER="mock"
# console | msg91 ...  (console is refused in production)
SMS_PROVIDER="console"

# ---- App ----
APP_URL="http://localhost:3000"
APP_ENV="development"
