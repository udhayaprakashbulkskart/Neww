# Copy to .env.production and fill in. Production refuses to start with mock or console providers.
APP_URL="https://app.example.com"
APP_ENV="production"
# Generate each secret with: openssl rand -base64 48   (32+ characters each)
SESSION_SECRET=""
OTP_PEPPER=""
PAYMENT_WEBHOOK_SECRET=""
# Real gateway and SMS provider adapters must be implemented before enabling these.
PAYMENT_PROVIDER="razorpay"
SMS_PROVIDER="msg91"
