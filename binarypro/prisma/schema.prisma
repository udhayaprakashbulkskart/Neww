// CrownTree - database schema.
// Money is stored as BigInt minor units (paise, cents, fils ...). All currencies use 2 decimal places.
// Every balance movement is a balanced LedgerTransaction (double-entry); wallets are derived from entries.

generator client {
  provider      = "prisma-client-js"
  // Vercel functions run on Amazon Linux (rhel-openssl-3.0.x); local dev uses native.
  binaryTargets = ["native", "rhel-openssl-3.0.x"]
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

enum Role {
  MEMBER
  ADMIN
  FINANCE
  SUPPORT
  MERCHANT
  ADVERTISER
}

enum Tier {
  BASIC
  SILVER
  GOLD
  PLATINUM
}

enum Currency {
  INR
  USD
  EUR
  GBP
  AED
  SGD
  MYR
  SAR
}

enum Side {
  LEFT
  RIGHT
}

enum Rank {
  MEMBER
  SENIOR_MEMBER
  TEAM_LEADER
  MANAGER
  DIRECTOR
  AMBASSADOR
}

enum UserStatus {
  ACTIVE
  SUSPENDED
  DELETED // self-deleted: personal data removed, financial records kept
}

enum KycStatus {
  NOT_SUBMITTED
  PENDING
  VERIFIED
  REJECTED
}

enum PaymentKind {
  MEMBERSHIP
  ORDER
  ADS_TOPUP
}

enum PaymentStatus {
  PENDING
  CAPTURED
  MISMATCH
  FAILED
}

enum OrderStatus {
  PENDING_PAYMENT
  PAID
  DELIVERED
  VERIFIED
  RETURNED
  CANCELLED
}

enum CommissionType {
  DIRECT
  BINARY
}

enum CommissionStatus {
  POSTED
  REVERSED
}

enum WithdrawalStatus {
  REQUESTED
  APPROVED
  REJECTED
}

enum CampaignStatus {
  PENDING_REVIEW
  ACTIVE
  PAUSED
  ENDED
}

enum CouponFunding {
  MERCHANT
  PROMO
}

enum Direction {
  DEBIT
  CREDIT
}

enum Normal {
  DEBIT
  CREDIT
}

model User {
  id                String     @id @default(cuid())
  phone             String?    @unique
  name              String
  email             String?    @unique
  // scrypt hash: scrypt$<salt>$<key>. Null only for accounts created before password sign-in.
  passwordHash      String?
  failedLogins      Int        @default(0)
  lockedUntil       DateTime?
  role              Role       @default(MEMBER)
  status            UserStatus @default(ACTIVE)
  kyc               KycStatus  @default(NOT_SUBMITTED)
  country           String     @default("IN")
  preferredCurrency Currency   @default(INR)
  // Language code (for example en, ar, de, fr, ja). Set by the user or from the country default.
  language          String     @default("en")
  // True once the user chooses country, language or currency. Automatic detection never overrides it.
  regionChosen      Boolean    @default(false)
  // Display currency chosen by the user (may be display-only, such as JPY). Null means follow the country.
  displayCurrency   String?
  rank              Rank       @default(MEMBER)
  sessionVersion    Int        @default(0)
  // Set for MERCHANT staff: the merchant whose orders this user may deliver.
  merchantId        String?
  // Shareable referral number members give to new sign-ups (sponsor lookup).
  referralCode      String?    @unique
  kycSubmittedAt    DateTime?
  kycReviewedAt     DateTime?
  kycReviewedBy     String?
  kycNote           String?
  createdAt         DateTime   @default(now())

  // Sponsorship (who referred this member; drives direct commission)
  sponsorId String?
  sponsor   User?   @relation("Sponsorship", fields: [sponsorId], references: [id])
  referrals User[]  @relation("Sponsorship")

  // Binary placement (user-selected position; drives PV and binary commission)
  parentId String?
  parent   User?   @relation("Placement", fields: [parentId], references: [id])
  children User[]  @relation("Placement")
  side     Side?

  membership        Membership?
  kycDocuments      KycDocument[]
  spinSpins         SpinSpin[]
  spinRedemptions   SpinRedemption[]
  spinClaims        SpinClaim[]
  bankAccount       BankAccount?
  orders            Order[]                  @relation("BuyerOrders")
  commissions       Commission[]
  withdrawals       Withdrawal[]
  adViews           AdView[]
  campaigns         AdCampaign[]
  partnerClicks     PartnerClick[]
  milestoneAwards   MilestoneAward[]
  otpCodes          OtpCode[]
  pvLegs            PvLeg[]
  financeVolume     VolumeEntry[]
  commissionEntries CommissionEntry[]
  dailySummaries    DailyCommissionSummary[]

  // Exactly one member may occupy each binary slot.
  @@unique([parentId, side])
  @@index([sponsorId])
}

model OtpCode {
  id        String   @id @default(cuid())
  phone     String
  codeHash  String
  expiresAt DateTime
  attempts  Int      @default(0)
  consumed  Boolean  @default(false)
  createdAt DateTime @default(now())
  user      User?    @relation(fields: [userId], references: [id])
  userId    String?

  @@index([phone, createdAt])
}

model Membership {
  id        String   @id @default(cuid())
  userId    String   @unique
  user      User     @relation(fields: [userId], references: [id])
  tier      Tier
  active    Boolean  @default(true)
  startedAt DateTime @default(now())
  expiresAt DateTime
}

model Payment {
  id          String        @id @default(cuid())
  kind        PaymentKind
  referenceId String
  userId      String
  amountMinor BigInt
  currency    Currency
  status      PaymentStatus @default(PENDING)
  providerRef String        @unique
  createdAt   DateTime      @default(now())
  capturedAt  DateTime?
  // Set only when staff confirm a bank transfer by hand. Unique so one transfer confirms one payment.
  bankRef     String?       @unique
  confirmedBy String?

  @@index([referenceId])
}

model WebhookEvent {
  id              String   @id @default(cuid())
  providerEventId String   @unique
  type            String
  receivedAt      DateTime @default(now())
}

model Merchant {
  id        String    @id @default(cuid())
  name      String
  active    Boolean   @default(true)
  createdAt DateTime  @default(now())
  products  Product[]
  orders    Order[]
  coupons   Coupon[]
}

model Product {
  id         String      @id @default(cuid())
  merchantId String
  merchant   Merchant    @relation(fields: [merchantId], references: [id])
  name       String
  priceMinor BigInt
  currency   Currency
  active     Boolean     @default(true)
  orderItems OrderItem[]
}

model Order {
  id                 String             @id @default(cuid())
  buyerId            String
  buyer              User               @relation("BuyerOrders", fields: [buyerId], references: [id])
  merchantId         String
  merchant           Merchant           @relation(fields: [merchantId], references: [id])
  status             OrderStatus        @default(PENDING_PAYMENT)
  currency           Currency
  subtotalMinor      BigInt
  // Retail sales value converted to INR minor units. This is the Point Value (PV) used for
  // binary volume and for direct commission. Only verified retail sales count.
  pvInrMinor         BigInt             @default(0)
  cashbackMinor      BigInt             @default(0)
  couponId           String?
  paidAt             DateTime?
  deliveredAt        DateTime?
  returnWindowEndsAt DateTime?
  verifiedAt         DateTime?
  returnedAt         DateTime?
  commissionBlocked  String? // reason when commissions/PV were withheld (fraud rules)
  refundDueMinor     BigInt             @default(0)
  createdAt          DateTime           @default(now())
  items              OrderItem[]
  commissions        Commission[]
  redemptions        CouponRedemption[]
  refund             Refund?
  commissionEntries  CommissionEntry[]
  volumeEntries      VolumeEntry[]

  @@index([buyerId])
  @@index([status])
}

model OrderItem {
  id             String  @id @default(cuid())
  orderId        String
  order          Order   @relation(fields: [orderId], references: [id])
  productId      String
  product        Product @relation(fields: [productId], references: [id])
  quantity       Int
  unitPriceMinor BigInt
}

model Coupon {
  id               String             @id @default(cuid())
  code             String             @unique
  funding          CouponFunding
  merchantId       String?
  merchant         Merchant?          @relation(fields: [merchantId], references: [id])
  percent          Int // only 10, 20, 30 or 50 (enforced in code and by CHECK constraint)
  maxCashbackMinor BigInt
  minOrderMinor    BigInt             @default(0)
  currency         Currency
  budgetMinor      BigInt // informational cap; the ledger pool balance is the real limit
  perUserLimit     Int                @default(1)
  startsAt         DateTime
  endsAt           DateTime
  active           Boolean            @default(true)
  createdAt        DateTime           @default(now())
  redemptions      CouponRedemption[]
}

model CouponRedemption {
  id            String   @id @default(cuid())
  couponId      String
  coupon        Coupon   @relation(fields: [couponId], references: [id])
  userId        String
  orderId       String   @unique
  order         Order    @relation(fields: [orderId], references: [id])
  cashbackMinor BigInt
  reversed      Boolean  @default(false)
  createdAt     DateTime @default(now())

  @@index([couponId, userId])
}

model Commission {
  id            String           @id @default(cuid())
  userId        String
  user          User             @relation(fields: [userId], references: [id])
  type          CommissionType
  sourceOrderId String?
  order         Order?           @relation(fields: [sourceOrderId], references: [id])
  periodKey     String?
  amountMinor   BigInt // INR minor units
  status        CommissionStatus @default(POSTED)
  createdAt     DateTime         @default(now())

  @@unique([userId, type, sourceOrderId])
  @@unique([userId, type, periodKey])
}

// Unmatched binary volume per member per side (carry-forward is simply what is left here).
model PvLeg {
  userId  String
  user    User   @relation(fields: [userId], references: [id])
  side    Side
  pvMinor BigInt @default(0)

  @@id([userId, side])
}

model BinaryRun {
  periodKey String   @id
  ranAt     DateTime @default(now())
  paidMinor BigInt   @default(0)
  payouts   Int      @default(0)
}

model LedgerAccount {
  id            String        @id @default(cuid())
  key           String        @unique
  normal        Normal
  allowNegative Boolean       @default(false)
  currency      Currency
  userId        String?
  createdAt     DateTime      @default(now())
  entries       LedgerEntry[]
}

model LedgerTransaction {
  id          String        @id @default(cuid())
  reference   String        @unique // idempotency key
  type        String
  description String
  createdAt   DateTime      @default(now())
  entries     LedgerEntry[]
}

model LedgerEntry {
  id          String            @id @default(cuid())
  txId        String
  tx          LedgerTransaction @relation(fields: [txId], references: [id])
  accountId   String
  account     LedgerAccount     @relation(fields: [accountId], references: [id])
  direction   Direction
  amountMinor BigInt
  currency    Currency

  @@index([accountId])
  @@index([txId])
}

model Withdrawal {
  id          String           @id @default(cuid())
  userId      String
  user        User             @relation(fields: [userId], references: [id])
  currency    Currency
  amountMinor BigInt
  status      WithdrawalStatus @default(REQUESTED)
  reference   String           @unique
  requestedAt DateTime         @default(now())
  reviewedAt  DateTime?
  reviewedBy  String?
}

model AdCampaign {
  id          String         @id @default(cuid())
  // The advertiser who created the campaign (null for campaigns created by staff).
  ownerId     String?
  owner       User?          @relation(fields: [ownerId], references: [id])
  advertiser  String
  title       String
  videoUrl    String
  durationSec Int
  rewardMinor BigInt // paid to the viewer per completed view, in `currency`
  currency    Currency
  status      CampaignStatus @default(PENDING_REVIEW)
  createdAt   DateTime       @default(now())
  views       AdView[]

  @@index([ownerId])
}

model AdView {
  id          String     @id @default(cuid())
  userId      String
  user        User       @relation(fields: [userId], references: [id])
  campaignId  String
  campaign    AdCampaign @relation(fields: [campaignId], references: [id])
  dayKey      String
  startedAt   DateTime   @default(now())
  completedAt DateTime?
  rewardMinor BigInt     @default(0)

  @@unique([userId, campaignId, dayKey])
}

model FxRate {
  id        String   @id @default(cuid())
  // Transaction currencies and display-only currencies (for example JPY). Text so display-only codes need no enum change.
  currency  String   @unique
  // MANUAL (admin entered) or LIVE (fetched from the rate provider).
  source    String   @default("MANUAL")
  fetchedAt DateTime?
  // INR minor units per 1 whole unit of currency, scaled by 1e8 (INR itself = 1e8).
  rateE8    BigInt
  updatedAt DateTime @default(now())
}

model FraudFlag {
  id        String   @id @default(cuid())
  userId    String?
  kind      String
  detail    String
  resolved  Boolean  @default(false)
  createdAt DateTime @default(now())

  @@index([userId])
}

model AuditLog {
  id        String   @id @default(cuid())
  actorId   String?
  action    String
  targetId  String?
  meta      Json?
  createdAt DateTime @default(now())

  @@index([action, createdAt])
}

// Partner offers: outbound links only. No cashback is paid on partner purchases.
model PartnerOffer {
  id            String         @id @default(cuid())
  partnerName   String
  title         String
  category      String
  description   String?
  discountLabel String
  couponCode    String?
  offerUrl      String
  minTier       Tier
  validUntil    DateTime
  active        Boolean        @default(true)
  approvedBy    String
  approvalRef   String
  createdAt     DateTime       @default(now())
  clicks        PartnerClick[]

  @@index([active, validUntil])
  @@index([category])
}

model PartnerClick {
  id        String       @id @default(cuid())
  userId    String
  user      User         @relation(fields: [userId], references: [id])
  offerId   String
  offer     PartnerOffer @relation(fields: [offerId], references: [id])
  createdAt DateTime     @default(now())

  @@index([offerId])
  @@index([userId])
}

// Admin-editable membership catalogue. Commission rates and daily payout caps are NOT stored here:
// they stay in src/lib/domain/plans.ts until the owner approves a change.
model MembershipPlan {
  tier             Tier     @id
  name             String
  priceInrMinor    BigInt
  durationDays     Int
  couponMaxPercent Int
  adViewsPerDay    Int
  benefits         String[]
  active           Boolean  @default(true)
  updatedAt        DateTime @updatedAt
  updatedBy        String?
}

// Retail milestone programme. Counts a member's own verified retail sales only (never team or
// recruitment volume). Awards are prizes (goods), not cash, so they post nothing to the ledger.
enum MilestoneStatus {
  QUALIFIED
  APPROVED
  REJECTED
  FULFILLED
}

model MilestoneRule {
  id             String           @id
  name           String
  thresholdMinor BigInt // INR minor units of personal verified retail sales
  startsAt       DateTime
  endsAt         DateTime?
  active         Boolean          @default(true)
  createdAt      DateTime         @default(now())
  updatedAt      DateTime
  updatedBy      String?
  awards         MilestoneAward[]
}

model Prize {
  id           String           @id
  name         String
  model        String
  imageUrl     String
  description  String
  details      String[]
  supplierNote String
  active       Boolean          @default(true)
  sortOrder    Int              @default(0)
  createdAt    DateTime         @default(now())
  updatedAt    DateTime
  awards       MilestoneAward[]
}

model MilestoneAward {
  id           String          @id @default(cuid())
  userId       String
  user         User            @relation(fields: [userId], references: [id])
  ruleId       String
  rule         MilestoneRule   @relation(fields: [ruleId], references: [id])
  status       MilestoneStatus @default(QUALIFIED)
  metricMinor  BigInt // personal verified retail sales (INR) when the milestone was reached
  qualifiedAt  DateTime        @default(now())
  prizeId      String?
  prize        Prize?          @relation(fields: [prizeId], references: [id])
  decidedAt    DateTime?
  decidedBy    String?
  decisionNote String?
  fulfilledAt  DateTime?

  @@unique([userId, ruleId])
  @@index([status])
}

enum KycDocKind {
  AADHAAR
  PAN
}

// Identity document images. Stored encrypted (AES-256-GCM); only the ciphertext is kept in the database.
model KycDocument {
  id         String     @id @default(cuid())
  userId     String
  user       User       @relation(fields: [userId], references: [id])
  kind       KycDocKind
  mime       String
  sizeBytes  Int
  sha256     String
  ciphertext Bytes
  uploadedAt DateTime   @default(now())

  @@unique([userId, kind])
}

// Payout account. The full account number is encrypted; only the last four digits are kept in clear.
model BankAccount {
  id            String   @id @default(cuid())
  userId        String   @unique
  user          User     @relation(fields: [userId], references: [id])
  accountHolder String
  bankName      String
  ifsc          String
  accountLast4  String
  accountCipher Bytes
  createdAt     DateTime @default(now())
}

// ---------- Spin & Win (separate from the membership payment and MLM commission engines) ----------
enum SpinRewardKind {
  BADGE // display-only, granted immediately, no money
  CASH // money credited to the member's wallet from the reward pool; only when legally activated
  VOUCHER // non-cash voucher; a redemption request is raised for staff to fulfil
}

enum SpinOutcome {
  GRANTED
  CREDITED
  REDEMPTION_REQUESTED
}

enum SpinRedemptionStatus {
  REQUESTED
  APPROVED
  FULFILLED
  REJECTED
}

model SpinSettings {
  id           String   @id
  enabled      Boolean  @default(true)
  cooldownDays Int      @default(15)
  updatedAt    DateTime
  updatedBy    String?
}

model SpinReward {
  id              String         @id
  name            String
  description     String
  kind            SpinRewardKind
  amountMinor     BigInt         @default(0)
  active          Boolean        @default(false)
  // Cash rewards need a documented legal approval and funding source before they can be activated.
  cashLegalRef    String?
  cashFundingRef  String?
  cashActivatedAt DateTime?
  cashActivatedBy String?
  createdAt       DateTime       @default(now())
  updatedAt       DateTime
  slots           SpinSlot[]
  spins           SpinSpin[]
}

// A reward placed on one membership tier's wheel, with its relative weight.
model SpinSlot {
  id        String     @id @default(cuid())
  tier      Tier
  rewardId  String
  reward    SpinReward @relation(fields: [rewardId], references: [id])
  weight    Int
  active    Boolean    @default(true)
  sortOrder Int        @default(0)

  @@unique([tier, rewardId])
}

// Immutable spin log. Protected from UPDATE and DELETE by a database trigger.
model SpinSpin {
  id             String          @id @default(cuid())
  userId         String
  user           User            @relation(fields: [userId], references: [id])
  tier           Tier
  rewardId       String
  reward         SpinReward      @relation(fields: [rewardId], references: [id])
  rewardName     String
  rewardKind     SpinRewardKind
  amountMinor    BigInt          @default(0)
  outcome        SpinOutcome
  requestKey     String          @unique
  randomDraw     Int
  totalWeight    Int
  nextEligibleAt DateTime
  createdAt      DateTime        @default(now())
  redemption     SpinRedemption?
  claim          SpinClaim?

  @@index([userId, createdAt])
  @@index([rewardId])
}

model SpinRedemption {
  id          String               @id @default(cuid())
  spinId      String               @unique
  spin        SpinSpin             @relation(fields: [spinId], references: [id])
  userId      String
  user        User                 @relation(fields: [userId], references: [id])
  status      SpinRedemptionStatus @default(REQUESTED)
  voucherCode String?
  note        String?
  handledBy   String?
  handledAt   DateTime?
  createdAt   DateTime             @default(now())
  updatedAt   DateTime

  @@index([status])
}

enum SpinClaimStatus {
  HELD // won without a paid membership: waits until the member activates one
  CLAIMED // effect applied (wallet credit, voucher request, or badge kept)
}

// Claim state is kept apart from the immutable spin log so it can change when a member activates a membership.
model SpinClaim {
  id        String          @id @default(cuid())
  spinId    String          @unique
  spin      SpinSpin        @relation(fields: [spinId], references: [id])
  userId    String
  user      User            @relation(fields: [userId], references: [id])
  status    SpinClaimStatus
  claimedAt DateTime?
  createdAt DateTime        @default(now())
  updatedAt DateTime

  @@index([userId, status])
}

// ---------- Financial engine (Phase 2) ----------

enum CommissionKind {
  PRODUCT // verified product sale, capped by policy and by the daily cap
  SERVICE // verified service sale, capped by policy and by the daily cap
  DIRECT_SPONSOR // sponsor-linked commission: disabled until legal approval
  BINARY // team matching commission: disabled until legal approval
}

enum CommissionEventType {
  RELEASE // moved from pending to the member's available wallet by a daily settlement
  REVERSE // reversed after a refund or invalidation
}

enum VolumeKind {
  ACCRUE
  REVERSE
}

// The daily cap. Null means "not configured": no commission can be released until an administrator sets it.
model DailyCapSetting {
  id        String   @id
  capMinor  BigInt?
  reason    String?
  updatedAt DateTime
  updatedBy String?
}

// Versioned, immutable commission policy. A new version is created for every change.
model CommissionPolicy {
  id               String         @id @default(cuid())
  kind             CommissionKind
  version          Int
  rateBps          Int // maximum commission as basis points of the verified sale value
  active           Boolean
  legalApprovalRef String?
  reason           String
  createdBy        String?
  createdAt        DateTime       @default(now())

  @@unique([kind, version])
}

// Sales catalogue for services. Products stay in the existing Product model.
model Service {
  id          String   @id @default(cuid())
  name        String
  description String
  priceMinor  BigInt
  currency    Currency
  active      Boolean  @default(true)
  createdAt   DateTime @default(now())
  updatedAt   DateTime
}

// One refund per order. Written once, never changed.
model Refund {
  id          String   @id @default(cuid())
  orderId     String   @unique
  order       Order    @relation(fields: [orderId], references: [id])
  amountMinor BigInt
  currency    Currency
  reason      String
  reference   String   @unique
  actorId     String?
  createdAt   DateTime @default(now())
}

// Volume ledger: eligible sales volume per member. Never money, never expires, no left/right attribution.
model VolumeEntry {
  id        String     @id @default(cuid())
  userId    String
  user      User       @relation(fields: [userId], references: [id])
  orderId   String
  order     Order      @relation(fields: [orderId], references: [id])
  kind      VolumeKind
  pvMinor   BigInt
  dayKey    String
  createdAt DateTime   @default(now())

  @@unique([orderId, userId, kind])
  @@index([userId])
}

// Commission ledger, accrual side: eligible commission earned from a verified sale. Immutable.
model CommissionEntry {
  id            String            @id @default(cuid())
  userId        String
  user          User              @relation(fields: [userId], references: [id])
  orderId       String
  order         Order             @relation(fields: [orderId], references: [id])
  kind          CommissionKind
  policyVersion Int
  amountMinor   BigInt
  dayKey        String
  createdAt     DateTime          @default(now())
  events        CommissionEvent[]

  @@unique([orderId, userId, kind])
  @@index([userId, dayKey])
}

// Commission ledger, movement side: releases and reversals against an accrual. Immutable.
model CommissionEvent {
  id          String              @id @default(cuid())
  entryId     String
  entry       CommissionEntry     @relation(fields: [entryId], references: [id])
  type        CommissionEventType
  amountMinor BigInt
  dayKey      String
  reference   String              @unique
  createdAt   DateTime            @default(now())

  @@index([entryId])
}

// One row per member per business day: the result of the daily cap calculation. Immutable.
model DailyCommissionSummary {
  id              String   @id @default(cuid())
  userId          String
  user            User     @relation(fields: [userId], references: [id])
  dayKey          String
  eligibleMinor   BigInt
  carriedInMinor  BigInt
  payableMinor    BigInt
  carriedOutMinor BigInt
  capMinor        BigInt
  createdAt       DateTime @default(now())

  @@unique([userId, dayKey])
}

model ReconciliationReport {
  id        String   @id @default(cuid())
  status    String // PASS or FAIL
  findings  Json
  totals    Json
  actorId   String?
  createdAt DateTime @default(now())
}

/// Platform-wide settings (JSON), for example enabled countries and display defaults. Admin only.
model PlatformSetting {
  key       String   @id
  value     Json
  updatedBy String?
  updatedAt DateTime @default(now())
}

/// Admin translation overrides. The shipped dictionaries are complete; overrides refine wording.
model TranslationOverride {
  id        String   @id @default(cuid())
  locale    String
  key       String
  value     String
  updatedBy String?
  updatedAt DateTime @default(now())

  @@unique([locale, key])
}
